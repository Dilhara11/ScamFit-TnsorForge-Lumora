# Share training inputs, prepared data, run evidence, and exports privately.
# Exclude machine-local environments and downloaded encoder caches.
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
/cache/
*:Zone.Identifier

# Allow saved training models despite the root artifact rules.
!*.joblib
!*.pkl
!*.pickle
!*.pt
!*.pth
!*.onnx
!*.safetensors

# Saved evaluation evidence; other runtime databases remain ignored.
!/runs/final/benign_replay.sqlite
!/runs/final/final_replay.sqlite

# v2: encoder weights are ~450 MB (GitHub limit 100 MB). Everything else in the
# bundle is tracked; app/server/scripts/fetch_model_weights.py restores the weights
# at the pinned revision and checks them against the manifest.
/runs/*/candidates/*/bundle/encoder/model.safetensors
/runs/*/candidates/*/bundle/encoder/**/*.partial
